# Copy to Src/.env and fill in (install.sh creates Src/.env with at least DISCORD_TOKEN).

DISCORD_TOKEN=

# Application ID from https://discord.com/developers/applications (used for /about invite + top.gg link)
DISCORD_APPLICATION_ID=

# Optional: bot owner Discord user ID for /about and owner-only prefix commands
COFFEECORD_OWNER_ID=

# Optional: override default OAuth permission bitmask for the invite link
# DISCORD_INVITE_PERMISSIONS=8866461766385655

# Optional: support server link buttons and Ko-fi help text
COFFEECORD_SUPPORT_SERVER_URL=
COFFEECORD_SUPPORT_INVITE=

# Optional: same fields in Storage/Config/bot_branding.json (used when env is unset;
# survives re-running install.sh and is included in storage-only backups). Env wins if set.

# Optional: GitHub API for c-cord update (private repo or rate limits)
# GITHUB_TOKEN=

# --- Full instance backup (separate from this file) ---
# From repo root:  ./scripts/backup_instance_data.sh   or  ./backup_instance_data.sh
#   (includes Storage/ + Src/.env + Src/ticket.env when present — tarball is secret; do not commit)
# ./scripts/backup_instance_data.sh --storage-only   # only JSON data, no .env
# Restore: ./scripts/restore_instance_data.sh   or  ./restore_instance_data.sh
# Other path: ./scripts/restore_instance_data.sh --archive /path/to/backup.tgz
# Verbose:    ./scripts/restore_instance_data.sh -v
# top.gg / OAuth invite URLs use DISCORD_APPLICATION_ID from .env, not Storage/.
